# Development environment (Vite dev server on :3005, API running locally on :8080)
VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_PATH=/api/

# Vite base path for assets of this app: the prefix the API serves it under (FrontendAssetsService.frontendMap)
VITE_BASE_PATH=/admin/

# Environment flag
VITE_IS_PRODUCTION=false
