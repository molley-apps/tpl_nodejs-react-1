# Production environment: the API serves this app, so it calls /api on its own origin
VITE_API_BASE_URL=
VITE_API_BASE_PATH=/api/

# Vite base path for assets of this app: the prefix the API serves it under (FrontendAssetsService.frontendMap)
VITE_BASE_PATH=/users/

# Environment flag
VITE_IS_PRODUCTION=true
