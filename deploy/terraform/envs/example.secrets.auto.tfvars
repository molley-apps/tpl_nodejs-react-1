# Copy to envs/<env>.secrets.auto.tfvars (gitignored) and fill in. Terraform
# writes these into Secret Manager with write-only arguments; they never enter
# the state file. The auth secret is generated by Terraform, nothing to add here.
#
# Molley's provisioner does not use this file: it passes the same values as
# TF_VAR_mongo_host, TF_VAR_mongo_user, TF_VAR_mongo_password, TF_VAR_email_password.

mongo_host     = "cluster0.abcde.mongodb.net" # SRV hostname only, no mongodb+srv://
mongo_user     = "db_user"
mongo_password = "db_password"
email_password = "SG.sendgrid-api-key"
