{% extends "_layout/layout1.html.njk" %}

{% block subject %}Your sign in link{% endblock %}

{% block message %}
  <tr class="content">
    <td>
      <table width="100%" class="pb-md">
        <h1 class="title mb-lg" style="text-align: center;">Sign in to {{ appName }}</h1>

        <p>Hi {{ name }},</p>

        <p>Click the button below to sign in. The link can be used once and expires in five minutes.</p>

        <p style="text-align: center;"><a class="button" href="{{ url }}">Sign in</a></p>

        <p>If you did not request this link, you can ignore this email.</p>
      </table>
    </td>
  </tr>

  {% include "_layout/footer/immutableFooter.html.njk" %}
{% endblock %}
