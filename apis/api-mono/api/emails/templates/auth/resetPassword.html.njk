{% extends "_layout/layout1.html.njk" %}

{% block subject %}Reset your password{% endblock %}

{% block message %}
  <tr class="content">
    <td>
      <table width="100%" class="pb-md">
        <h1 class="title mb-lg" style="text-align: center;">Reset your password</h1>

        <p>Hi {{ name }},</p>

        <p>We received a request to reset the password for your {{ appName }} account. Click the button below to choose a new password. The link expires in one hour.</p>

        <p style="text-align: center;"><a class="button" href="{{ url }}">Reset password</a></p>

        <p>If you did not request this, you can ignore this email and your password will stay the same.</p>
      </table>
    </td>
  </tr>

  {% include "_layout/footer/immutableFooter.html.njk" %}
{% endblock %}
