# Full settings available here: src/config.ts
# Local development runs the API directly: cp .env.example .env, then `npm run dev:start` (http://localhost:8080).
# Deployed, every value below is injected as Cloud Run env vars and Secret Manager secrets (deploy/terraform).

# PORT default is 8080
# PORT=8000

# local | development | production
# `local` serves the frontends from the repo's frontends/<app>/dist folders on disk; anything else streams them
# from the GCS bucket below.
NODE_ENV=local

# Shown in emails, the auth app name and the 403 page
APP_NAME=App Template
# Public origin of this deployment as the browser sees it: this API locally, the Cloud Run URL or custom domain
# when deployed. The API serves the frontends too, so this is the one origin for everything.
APP_URL=http://localhost:8080

# Authentication (Better Auth, self hosted in this API, users in MongoDB)
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public origin of this API. Leave empty on Cloud Run to infer it from x-forwarded-proto / host
AUTH_BASE_URL=http://localhost:8080
# Comma separated extra browser origins allowed to call the auth routes with credentials (the API's own origin
# is always trusted). Only the Vite dev servers need listing.
AUTH_TRUSTED_ORIGINS=http://localhost:3004,http://localhost:3005
# Block sign in until the verification email link is clicked
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# One-time key that makes the first signed-in user the administrator: sign up on the users app, then open
# http://localhost:8080/users/?setupKey=<this value>. Deployed, Terraform generates it. Empty disables the route.
ADMIN_SETUP_KEY=local-dev-setup-key-change-me-please

# Comma separated browser origins allowed to call /api cross-origin with credentials. Empty reflects every origin.
# CORS_WHITELIST=http://localhost:3004,http://localhost:3005

# mongodb+srv://<user>:<pass>@<sub.domain>.mongodb.net/?retryWrites=true&w=majority
MONGO_HOST=changeme.mongodb.net
MONGO_USER=changeme
MONGO_PW=changeme

# Email, LOCAL DEVELOPMENT FALLBACK ONLY (NODE_ENV=local with no provider saved in the admin app). FILE writes each
# email to emails/logs; or set EMAIL_MODE=NODEMAILER and point EMAIL_HOST at Mailpit (localhost:1025).
# Deployed, the administrator connects the real provider in the admin app under Settings → Email; these are ignored.
EMAIL_MODE=FILE
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USERNAME=apikey
# EMAIL_PASSWORD=
EMAIL_FALLBACK_FROM=no-reply@example.com

# Scheduled jobs (src/jobs). Deployed, Terraform sets these three and the API manages its own Cloud Scheduler jobs.
# Locally leave them unset: a 30 second timer in the API runs due jobs instead.
# GCP_PROJECT_ID=
# GCP_REGION=europe-west2
# SCHEDULER_INVOKER_EMAIL=

# Google Cloud Storage - the private bucket holding the built frontends, one folder per app
# (users/, admin/, ... see src/services/FrontendAssetsService.ts). Read with Application Default Credentials.
GCS_FRONTEND_BUCKET=dev-changeme
# Base URL for GCS (usually doesn't need to change)
GCS_BASE_URL=https://storage.googleapis.com

# Where NODE_ENV=local serves the apps from (<dir>/<app>/dist). Defaults to the repo's frontends folder.
# FRONTENDS_LOCAL_DIR=../../../frontends
# true adds X-Robots-Tag: noindex to every frontend response (set on the dev environment)
# FRONTENDS_NOINDEX=false

# Logger mode: error | warn | info | log | debug | verbose
# LOGGER_MODE=log
