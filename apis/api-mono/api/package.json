{
  "name": "api-mono",
  "description": "",
  "version": "0.0.1",
  "private": true,
  "author": "<add your company or personal name here>",
  "scripts": {
    "clean": "rm -rf build",
    "build": "npm run clean && tsc && tsc-alias",
    "dev:build": "tsc-watch --preserveWatchOutput --onSuccess 'npx tsc-alias'",
    "dev:setup": "git config core.hooksPath githooks && cp -n .env.example .env",
    "dev:start": "tsc-watch --preserveWatchOutput --onSuccess 'sh -c \"npx tsc-alias && npm start\"'",
    "dev:debug": "tsc-watch --preserveWatchOutput --onSuccess 'sh -c \"npx tsc-alias && node --inspect=127.0.0.1:9229 ./build/server.js\"'",
    "jest": "node --random-seed=42 node_modules/.bin/jest",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --check 'src/**/*.{js,ts,tsx,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,ts,tsx,json}'",
    "start": "node ./build/server.js",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "ENVIRONMENT=test npm run jest -- --silent --runInBand",
    "test:unit:single": "npm run jest -- --clearCache && ENVIRONMENT=test npm run jest -- --collectCoverage false --verbose --forceExit --detectOpenHandles",
    "generate:help": "generate-it --help",
    "generate:server": "generate-it ../api-spec/release/api-spec.yml --yes -t https://github.com/molley-io/tpl_generate-it-express-server.git",
    "migrate-mongo": "migrate-mongo",
    "migration:create": "migrate-mongo create",
    "migration:up": "migrate-mongo up",
    "migration:down": "migrate-mongo down",
    "migration:status": "migrate-mongo status"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "@google-cloud/storage": "^7.21.0",
    "@typegoose/typegoose": "~13.5.0",
    "better-auth": "^1.7.7",
    "celebrate": "^15.0.3",
    "cli-color": "^2.0.4",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-form-data": "^3.0.1",
    "fs-extra": "^11.3.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "migrate-mongo": "^11.0.0",
    "mime-types": "^3.0.1",
    "mongoose": "~9.9.5",
    "morgan": "^1.12.1",
    "nunjucks-emailer": "^5.0.0",
    "object-reduce-by-map": "^3.3.0",
    "proc-env-helper": "^1.1.0",
    "recursive-readdir-sync": "^1.0.6",
    "request-ip": "^3.3.0",
    "source-map-support": "^0.5.21",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cli-color": "^2.0.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-form-data": "^2.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/migrate-mongo": "^10.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.18.11",
    "@types/nodemailer": "^7.0.12",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.3",
    "@types/ws": "^8.18.1",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^5.47.0",
    "@typescript-eslint/parser": "^5.47.0",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-deprecate": "^0.7.0",
    "eslint-plugin-prettier": "^5.2.1",
    "generate-it": "^5.63.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemailer": "^7.0.13",
    "prettier": "^3.3.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.4",
    "tsc-alias": "^1.8.10",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.8.3"
  },
  "mockingServer": false
}
